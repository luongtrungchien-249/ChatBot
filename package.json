{
  "name": "chien-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:cli": "tsx watch --env-file-if-exists=.env src/main/cli.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/main/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/main/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/main/api.js",
    "start:worker": "node dist/main/worker.js",
    "test": "vitest run test/unit test/contract --passWithNoTests",
    "test:int": "vitest run test/integration test/security --passWithNoTests",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "guard:sql": "node ops/guard-sql.mjs",
    "migrate": "tsx --env-file-if-exists=.env src/main/cli.ts migrate",
    "eval": "tsx evals/runner.ts",
    "dev:web": "vite --config web/vite.config.ts web",
    "build:web": "vite build --config web/vite.config.ts web"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "bullmq": "^5.0.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.0.0",
    "openai": "^7.10.0",
    "pg": "^8.11.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "dependency-cruiser": "^16.0.0",
    "pino-pretty": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.0.0"
  }
}
