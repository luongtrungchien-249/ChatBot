# Cuong che 8 luat kien truc trong ARCHITECTURE.md section 1.
# Chay: uv run lint-imports   (bat buoc trong CI)
#
# Moi luat phai duoc CHUNG MINH bang canary vi pham co y — xem ops/canary_import_rules.py
# va docs/dep-rules-verified.md. Mot luat viet sai van chay xanh; no chi don gian
# khong bat duoc gi.

[importlinter]
# Muoi goi cap cao nhat, moi goi la mot TANG. Khong co goi bao boc ngoai, nen phai
# liet ke tung cai o day — them mot tang moi thi nho them vao danh sach nay, neu
# khong luat se im lang bo qua ca tang do.
root_packages =
    adapters
    agents
    config
    infra
    knowledge
    llm
    main
    memory
    shared
    tho
    tools

[importlinter:contract:1]
name = L1: agents khong biet ha tang
type = forbidden
source_modules =
    agents
forbidden_modules =
    adapters
    infra
    llm
    memory
    knowledge
    tools

# L7 (chi config duoc cham bien moi truong) KHONG kiem duoc bang import-linter:
# no so khop IMPORT MODULE, con os.environ la truy cap THUOC TINH. Luat do duoc
# cuong che boi ops/guard_env.py, chay trong CI cung voi lint-imports.
#
# Tuong tu, L4 co hai nua: nua "khong import fact_repo" o hop dong 5 duoi day, va
# nua "khong viet SQL cham bang memory_fact" o ops/guard_sql.py.

[importlinter:contract:2]
name = L1: agents khong doc config
type = forbidden
source_modules =
    agents
forbidden_modules =
    config

[importlinter:contract:3]
name = L5: moi adapter la mot hop kin
type = independence
modules =
    adapters.cli
    adapters.web
    adapters.zalo_bot

[importlinter:contract:4]
name = L5: adapter khong goi LLM, khong doc memory hay knowledge
type = forbidden
source_modules =
    adapters
forbidden_modules =
    llm
    memory
    knowledge

[importlinter:contract:5]
name = L4: chi memory.repository duoc cham bang memory_fact
type = forbidden
source_modules =
    agents
    adapters
    knowledge
    tools
    infra
forbidden_modules =
    memory.repository.fact_repo


[importlinter:contract:6]
# `tho` la goi THUAN: luat tho, bo kiem, bo cham diem — khong I/O, khong goi model,
# khong doc config. `agents/` import no (nhan dien y dinh + stage lam tho), va dieu do
# HOP LE chinh vi no thuan.
#
# Truoc 17/09/2026 `tho` KHONG nam trong root_packages, nen khong luat nao gac no. No
# thuan mot cach TINH CO, khong phai mot cach duoc giu. Ngay no import mot tang ha
# tang thi `agents` phu thuoc ha tang GIAN TIEP, `lint-imports` van xanh, va unit test
# cua agents bat dau doi bien moi truong — dung trieu chung ma L2 sinh ra de tranh, va
# no da xay ra mot lan voi `tools/guard.py` (xem docs/plan-thi-cong.md muc 5.9).
#
# `shared` KHONG nam trong danh sach cam: no cung la goi thuan, va `tho` duoc dung no.
name = L1b: tho la goi THUAN, khong duoc cham ha tang
type = forbidden
source_modules =
    tho
forbidden_modules =
    adapters
    config
    infra
    knowledge
    llm
    main
    memory
    tools
