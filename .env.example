# Moi bien o day deu khai trong src/config/schema.ts.
# Thieu mot bien => process khong khoi dong duoc (fail fast).

NODE_ENV=development
LOG_LEVEL=info

# --- LLM ---
OPENAI_API_KEY=

# --- Embedding & Rerank. Xem ARCHITECTURE.md section 8.2 ---
# Tuan 1-3 chua dung RAG: dien 'fake' de process khoi dong duoc.
#   EMBEDDING_PROVIDER=fake  EMBEDDING_API_KEY=dev  EMBEDDING_MODEL=fake
#   RERANK_PROVIDER=fake     RERANK_API_KEY=dev     RERANK_MODEL=fake
# Chot nha cung cap that o tuan 4. Rang buoc cung: so chieu phai bang 1024.
# OpenAI khong co API rerank -> rerank phai la nha cung cap thu hai.
# Da DO ca hai model, 07/09/2026 (uv run python ops/benchmark_embedding.py):
#   3-large  khoang an toan +0,212  top-1 7/8  bien +0,074  $0,13/1M
#   3-small  khoang an toan +0,171  top-1 6/8  bien +0,034  $0,02/1M
# 3-small re hon 6,5 lan nhung xep sai 2/8 cau va bien phan biet tut hon MOT NUA;
# `bat_min` cua no (0,695) con nam DUOI DUPLICATE_THRESHOLD = 0,70 dang dung.
# Ma embedding chi chiem ~7% chi phi, nen doi de tiet kiem 6% cua 7% la khong dang.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=                # chi can khi provider KHAC openai; openai dung chung OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_PROVIDER=
RERANK_API_KEY=
RERANK_MODEL=
# PHU THUOC NHA CUNG CAP. Hai cross-encoder khac nhau tra ve hai thang diem khac
# nhau, nen bung nguong tu nha nay sang nha kia la doan mo.
# Do 07/09/2026 voi ban KHONG KHOA (RERANK_PROVIDER khac 'cohere'), tren mot so tay
# that: chunk DUNG dat 0,750-0,889, chunk SAI dat toi 0,500. Tuc la 0,35 CHO LOT
# chunk sai vao prompt. Chot nha cung cap that thi chay lai:
#     uv run python ops/benchmark_rerank.py evals/dataset/qa.jsonl
RERANK_MIN_SCORE=0.55

# --- Ha tang ---
DATABASE_URL=postgres://bot:bot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379

# --- Zalo Bot Platform ---
ZALO_BOT_TOKEN=
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=

# --- Chinh sach ---
BOT_MENTION_NAME=CP_Assistant,CP,Bot_CP_Assistant
GROUP_POLICY=allowlist
DM_POLICY=pairing
MEMORY_IMPLICIT_ENABLED=false      # bot TU trich fact — chi bat sau khi da chay duoc `cli memory`
RL_USER_PER_MIN=10
RL_THREAD_PER_MIN=30

# BAT BUOC. Khong co mac dinh. Xem ARCHITECTURE.md section 8.3 de tinh nguoc tu ngan sach.
DAILY_BUDGET_USD=

# --- Giao dien web (chi localhost, chua co auth) ---
WEB_PORT=3000
WEB_BIND=127.0.0.1

# --- Cong cu (giai doan 3) ---
# De TRONG thi cong cu do khong duoc khai trong ToolPort.specs().
# paper_search chay duoc ma KHONG can khoa nao (OpenAlex, arXiv, Crossref deu mo).
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# YouTube Data API v3 — can cho cong cu `youtube_stats` (luot xem/thich/binh luan).
# Lay mien phi: console.cloud.google.com -> tao project -> bat "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key.
# Han muc 10.000 don vi/ngay; moi lan tra cuu ton 1 don vi.
YOUTUBE_API_KEY=
REACT_MAX_ITERATIONS=8
REACT_DEADLINE_MS=60000
