# Moi bien o day deu khai trong src/config/schema.ts.
# Thieu mot bien => process khong khoi dong duoc (fail fast).

NODE_ENV=development
LOG_LEVEL=info

# --- LLM ---
OPENAI_API_KEY=

# --- Embedding & Rerank. Xem ARCHITECTURE.md section 8.2 ---
# Tuan 1-3 chua dung RAG: dien 'fake' de process khoi dong duoc.
#   EMBEDDING_PROVIDER=fake  EMBEDDING_API_KEY=dev  EMBEDDING_MODEL=fake
#   RERANK_PROVIDER=fake     RERANK_API_KEY=dev     RERANK_MODEL=fake
# Chot nha cung cap that o tuan 4. Rang buoc cung: so chieu phai bang 1024.
# OpenAI khong co API rerank -> rerank phai la nha cung cap thu hai.
# Da DO ca hai model, 07/09/2026 (uv run python ops/benchmark_embedding.py):
#   3-large  khoang an toan +0,212  top-1 7/8  bien +0,074  $0,13/1M
#   3-small  khoang an toan +0,171  top-1 6/8  bien +0,034  $0,02/1M
# 3-small re hon 6,5 lan nhung xep sai 2/8 cau va bien phan biet tut hon MOT NUA;
# `bat_min` cua no (0,695) con nam DUOI DUPLICATE_THRESHOLD = 0,70 dang dung.
# Ma embedding chi chiem ~7% chi phi, nen doi de tiet kiem 6% cua 7% la khong dang.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=                # chi can khi provider KHAC openai; openai dung chung OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024
RERANK_PROVIDER=
RERANK_API_KEY=
RERANK_MODEL=
# PHU THUOC NHA CUNG CAP. Hai cross-encoder khac nhau tra ve hai thang diem khac
# nhau, nen bung nguong tu nha nay sang nha kia la doan mo.
# Do 07/09/2026 voi ban KHONG KHOA (RERANK_PROVIDER khac 'cohere'), tren mot so tay
# that TIENG VIET: chunk DUNG dat 0,750-0,889, chunk SAI dat toi 0,500. Tuc la 0,35
# CHO LOT chunk sai vao prompt.
#
# Do lai 08/09/2026 tren corpus TIENG ANH (cookbook, 132 chunk, 25 cau hoi):
#
#     nguong   Recall@5   cau CO tai lieu ma tra RONG   cau KHONG co, tra RONG (dung)
#     0,25     91,3%      0/22                          1/3
#     0,35     91,3%      0/22                          1/3
#     0,45     90,1%      0/22                          2/3   <- dang dat
#     0,55     73,0%      3/22                          3/3
#
# Recall@5 TRUOC rerank la 96,1%, tuc duong tim kiem khong phai nut that — tang
# rerank moi la cho mat 23 diem.
#
# NGUONG NAY PHU THUOC CORPUS, khong co gia tri dung chung. 0,55 toi uu cho "biet noi
# khong tim thay"; 0,45 toi uu cho "tim duoc thu co that". Chon theo corpus THAT cua
# ban, va do lai khi corpus doi:
#     uv run python ops/benchmark_rerank.py evals/dataset/qa.jsonl
RERANK_MIN_SCORE=0.45

# Tran khoang cach cosine — CHI dung khi RERANK_PROVIDER khong phai cross-encoder that.
# Ban du phong cham do trung TU VUNG nen khong duoc quyen loc; khoang cach vector moi
# la thu co hieu chuan ngu nghia. Do 08/09/2026 tren 14 cau hoi tieng Viet:
#   corpus tieng ANH:      trong 0,4382-0,7587 | ngoai 0,7918-0,9294  -> 0,78
#   corpus TRON Anh+Viet:  trong 0,3183-0,5607 | ngoai 0,6987-0,7751  -> 0,63
# Them tai lieu tieng Viet keo moi cau hoi tieng Viet lai gan hon nen nguong phai ha.
# Do lai moi khi corpus doi.
RAG_MAX_DISTANCE=0.63

# Tren nguong nay thi lan tim bi coi la CHUNG CHUNG: cong cu KHONG tra ve noi dung ma
# tra ve mot danh sach ung vien co that de NGUOI DUNG chon, kem mot dong "Khac". Chon
# xong, model goi lai cong cu voi tham so `chon` va lan do tra sau (k=12), khong hoi
# nua. Xem tools/knowledge_search.py.
#
# Vi sao can: cau "Mon nao dung pho mai va mi ong" cho ra mot mo mon dang dang pasta,
# khong mon nao la dap an, va bot van tra loi nhu that. Truot IM LANG — nguoi dung
# khong co cach nao biet ket qua chi la "gan gan".
#
# Do 10/09/2026 tren kho that (179 chunk), khoang cach cua ung vien GAN NHAT:
#   hoi thang mot muc co ten   0,2468  0,2613  0,2810  0,3499
#   hoi chung chung / mo ho    0,3504  0,4658  0,5061  0,5629  0,5625  0,5960
# Hai lop cham nhau quanh 0,35, nen 0,50 (nam trong khoang trong 0,466-0,506) giu duoc
# cac cau dang tra loi DUNG ma van bat duoc cau mo ho.
#
# Ha xuong = hoi lai nhieu hon. Nang len = im lang doan nhieu hon. Dat CAO hon
# RAG_MAX_DISTANCE la TAT tinh nang: moi thu qua duoc loc kia deu duoi nguong nay.
#
# CANH BAO: ba nguong tren day (RERANK_MIN_SCORE, RAG_MAX_DISTANCE, RAG_HOI_LAI_TU)
# deu hieu chuan voi RERANK_PROVIDER=fake. Cam khoa cross-encoder that vao thi phai do
# lai CA BA — diem va khoang cach se phan bo khac han.
RAG_HOI_LAI_TU=0.50

# --- Tu host model cho route `poem` (lam tho) ---
#
# De TRONG = route tho dung chung model voi ca bot. Day la mac dinh, va no chay duoc
# ngay khong can gi them.
#
# Dat vao day mot endpoint TUONG THICH OpenAI (vLLM, TGI) de tach rieng route tho:
#     POEM_BASE_URL=http://localhost:8000/v1
#     POEM_MODEL_ID=google/gemma-4-26b-a4b-it
#     POEM_API_KEY=khoa-gia
#
# Bat may phuc vu:  docker compose --profile tu-host up vllm
#
# PHAN CUNG LA DIEU KIEN, KHONG PHAI GOI Y. Model 26B can:
#     bf16        ~52 GB VRAM
#     int8/fp8    ~26 GB
#     int4 (AWQ)  ~13-15 GB
# MoE VAN phai nap TOAN BO expert vao VRAM — phan thua chi nam o phep tinh.
#
# Do tren may dang phat trien 11/09/2026: RTX 3050 Ti Laptop, 4096 MiB = 4 GB.
# THIEU khoang 3,5 lan ngay ca o int4. Model se KHONG NAP NOI, khong phai chay cham.
#
# Chay CPU thi dung: 2-8 token/giay, tuc mot bai luc bat mat 15-60 giay — TE HON con
# so p95 hien tai, dung thu dang muon giam.
#
# GIA = 0 trong `llm/models.py`, vi chi phi that la GIO GPU va no khong quy ve token
# mot cach trung thuc duoc. Hau qua phai biet: route nay KHONG bao gio lam
# DAILY_BUDGET_USD nhich len, tuc chan ngan sach khong con bao ve gi cho no.
# DOI MODEL CHO RIENG ROUTE THO (khong can GPU, khong can vLLM):
#
#     POEM_MODEL_ID=gpt-4o-mini     $0,15 / $0,60   KHONG sinh token suy luan
#     POEM_MODEL_ID=gpt-5-nano      $0,05 / $0,40   re nhat, van la model reasoning
#     de trong                      $0,25 / $2,00   dung chung model voi ca bot
#
# TOKEN SUY LUAN TINH THEO GIA OUTPUT. `gpt-5-mini` va `gpt-5-nano` sinh them token
# suy luan va bi tinh tien nhu output; `gpt-4o-mini` thi khong. Voi viec lam tho,
# suy luan nhieu buoc gan nhu khong giup gi — luat tho da duoc cuong che bang code
# trong `tho/luat.py`. Nen chi phi THUC TE cua gpt-4o-mini co the thap hon con so
# $0,60 goi y. Phai do moi biet.
#
# CHI route nay duoc doi tu do. Moi luat trong SYSTEM_PROMPT deu duoc hieu chuan tren
# gpt-5-mini qua ba ngay do dac, nen doi model cho CA BOT se lam toan bo so lieu do
# het gia tri. Route tho khong dinh gi toi chung: khong dung SYSTEM_PROMPT, khong goi
# cong cu, khong qua vong ReAct.
#
# Go nham ten thi tu roi ve model chung, khong chet.
POEM_BASE_URL=
POEM_MODEL_ID=
POEM_API_KEY=khong-can

# --- Ha tang ---
DATABASE_URL=postgres://bot:bot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379

# --- Zalo Bot Platform ---
ZALO_BOT_TOKEN=
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=

# --- Chinh sach ---
BOT_MENTION_NAME=CP_Assistant,CP,Bot_CP_Assistant
GROUP_POLICY=allowlist
DM_POLICY=pairing
MEMORY_IMPLICIT_ENABLED=false      # bot TU trich fact — chi bat sau khi da chay duoc `cli memory`
RL_USER_PER_MIN=10
RL_THREAD_PER_MIN=30

# BAT BUOC. Khong co mac dinh. Xem ARCHITECTURE.md section 8.3 de tinh nguoc tu ngan sach.
DAILY_BUDGET_USD=

# --- Giao dien web (chi localhost, chua co auth) ---
WEB_PORT=3000
WEB_BIND=127.0.0.1

# --- Cong cu (giai doan 3) ---
# De TRONG thi cong cu do khong duoc khai trong ToolPort.specs().
# paper_search chay duoc ma KHONG can khoa nao (OpenAlex, arXiv, Crossref deu mo).
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
# YouTube Data API v3 — can cho cong cu `youtube_stats` (luot xem/thich/binh luan).
# Lay mien phi: console.cloud.google.com -> tao project -> bat "YouTube Data API v3"
# -> Credentials -> Create credentials -> API key.
# Han muc 10.000 don vi/ngay; moi lan tra cuu ton 1 don vi.
YOUTUBE_API_KEY=
REACT_MAX_ITERATIONS=8
REACT_DEADLINE_MS=60000
