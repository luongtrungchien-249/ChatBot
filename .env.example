# Moi bien o day deu khai trong src/config/schema.ts.
# Thieu mot bien => process khong khoi dong duoc (fail fast).

NODE_ENV=development
LOG_LEVEL=info

# --- LLM ---
ANTHROPIC_API_KEY=

# --- Embedding & Rerank: KHONG phai Anthropic. Xem ARCHITECTURE.md section 8.2 ---
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
RERANK_PROVIDER=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_MIN_SCORE=0.35

# --- Ha tang ---
DATABASE_URL=postgres://bot:bot@localhost:5432/chatbot
REDIS_URL=redis://localhost:6379

# --- Zalo Bot Platform ---
ZALO_BOT_TOKEN=
ZALO_MODE=polling
ZALO_WEBHOOK_SECRET=

# --- Messenger ---
META_APP_SECRET=
META_PAGE_TOKEN=
META_VERIFY_TOKEN=

# --- Chinh sach ---
BOT_MENTION_NAME=nam_chatbot
GROUP_POLICY=allowlist
DM_POLICY=pairing
RL_USER_PER_MIN=10
RL_THREAD_PER_MIN=30

# BAT BUOC. Khong co mac dinh. Xem ARCHITECTURE.md section 8.3 de tinh nguoc tu ngan sach.
DAILY_BUDGET_USD=
