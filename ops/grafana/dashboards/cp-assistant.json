{
  "__inputs": [],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Daily budget consumed (%)",
      "description": "Recorded daily spend / positive configured budget. Provisional warning at 70%, critical at 90%; missing/invalid budget is No data. Unrecorded costs are not included.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "(cp_budget_spent_usd / cp_budget_limit_usd) and (cp_budget_limit_usd > 0)",
          "legendFormat": "fraction consumed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tỉ lệ prompt caching",
      "description": "TỤT VỀ 0 = tiền tố ổn định của prompt đã vỡ. Ai đó nội suy biến vào đầu SYSTEM_PROMPT, và bạn đang trả giá đầy đủ cho ~1500 token ở MỌI câu hỏi.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "cp_prompt_cache_hit_ratio",
          "legendFormat": "tỉ lệ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.2
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lỗi gọi model",
      "description": "Khác 0 kéo dài: xem log tìm 401/403 (khoá sai) hay 5xx (upstream).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(cp_llm_errors_total)",
          "legendFormat": "tổng lỗi",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Độ trễ p95 theo route",
      "description": "Mục tiêu đường trả lời < 5000ms. Route `embed` chạm 20000ms là sát trần timeout — nó nằm trên đường phản hồi (L3 tìm fact ở mỗi tin nhắn).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "cp_llm_latency_p95_ms",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Chi phí theo route",
      "description": "Tiền đi đâu. `reply` thường áp đảo vì token output đắt gấp 8 lần input.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "cp_llm_cost_usd",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Số lần gọi model",
      "description": "`embed` cao hơn `reply` nhiều lần là bình thường: L3 và RAG đều embed câu hỏi.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "cp_llm_calls_total",
          "legendFormat": "{{route}} · {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker wall-clock latency and queue wait (5m)",
      "description": "Recent rolling p95; not the sum of parallel upstream durations.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 22},
      "targets": [
        {"expr": "cp_runtime_turn_latency_p95_ms", "legendFormat": "turn {{outcome}}", "refId": "A"},
        {"expr": "cp_queue_wait_p95_ms", "legendFormat": "queue wait {{outcome}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Process heartbeat age",
      "description": "Only measured ages are shown. Zalo is shown only when explicitly expected; missing observations are not zero. Provisional stale threshold: 120s.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 22},
      "targets": [
        {"expr": "cp_heartbeat_age_seconds{component=~\"worker|maintenance\"} or (cp_heartbeat_age_seconds{component=\"zalo\"} and on(instance,job,component) (cp_process_expected{component=\"zalo\"} == 1))", "legendFormat": "{{component}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "ARQ queue size includes jobs still in progress.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 30},
      "targets": [
        {"expr": "cp_queue_depth", "legendFormat": "{{queue}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Turn outcomes (rolling 5m)",
      "description": "Gauge of unique trace outcomes, not a monotonic counter. Do not use rate().",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 30},
      "targets": [
        {"expr": "cp_runtime_turns", "legendFormat": "{{outcome}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Sent fallback ratio (rolling 5m)",
      "description": "Only sent replies with measured fallback status; excludes silent retries and unknown historical rows.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
      "targets": [
        {"expr": "cp_runtime_fallbacks / clamp_min(cp_runtime_measured_replies, 1)", "legendFormat": "fallback ratio", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Turn stop reasons (rolling 5m)",
      "description": "Bounded, content-free reasons. Each trace retains its latest attempt, not a monotonic counter.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
      "targets": [
        {"expr": "cp_runtime_turn_reason", "legendFormat": "{{reason}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "ReAct work (rolling 5m)",
      "description": "Latest-attempt measurements only. ReAct counts do not include the separate poetry route.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 46},
      "targets": [
        {"expr": "cp_runtime_react_iterations", "legendFormat": "model calls", "refId": "A"},
        {"expr": "cp_runtime_tool_calls", "legendFormat": "tool calls", "refId": "B"},
        {"expr": "cp_runtime_tool_errors", "legendFormat": "failed observations", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "RAG tool outcomes (rolling 5m)",
      "description": "Counts tool attempts, including retries; not unique turns. Uncertain means candidates offered, not proof the final answer asked a question.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 54},
      "targets": [
        {"expr": "cp_rag_requests", "legendFormat": "{{outcome}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "RAG degradation and low confidence (5m)",
      "description": "Stage counts overlap: use stage=any for a deduplicated degradation ratio. Low confidence is a retrieval signal, not a calibrated correctness score.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 54},
      "targets": [
        {"expr": "cp_rag_degraded_requests", "legendFormat": "degraded {{stage}}", "refId": "A"},
        {"expr": "cp_rag_low_confidence_requests", "legendFormat": "low confidence", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "RAG tool latency p95 (rolling 5m)",
      "description": "Wall-clock per knowledge-tool attempt, including widening search/compression; not a sum of parallel branch latencies.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 62},
      "targets": [
        {"expr": "cp_rag_latency_p95_ms", "legendFormat": "{{outcome}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "min": 0}, "overrides": []}
    }
    ,{
      "id": 17,
      "type": "timeseries",
      "title": "Oldest original queue enqueue age",
      "description": "Includes deferred and in-progress jobs. Unknown/incomplete samples are omitted, not zero. Check cp_queue_age_complete on gaps.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 70},
      "targets": [
        {"expr": "cp_queue_oldest_age_seconds", "legendFormat": "{{queue}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Recorded daily spend and budget (USD)",
      "description": "Raw configured budget and recorded spend; the percentage panel controls provisional 70/90 percent warning colors. Costs missing from accounting are not zero.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 78},
      "targets": [
        {"expr": "cp_budget_spent_usd", "legendFormat": "recorded spend", "refId": "A"},
        {"expr": "cp_budget_limit_usd", "legendFormat": "configured budget", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []}
    },
    {
      "id": 19,
      "type": "stat",
      "title": "Zalo polling expectation",
      "description": "Operator configuration, not heartbeat health: 0 is intentionally disabled, 1 is expected. Missing metric is unknown. Inspect heartbeat age/observation for an expected process.",
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 78},
      "targets": [
        {"expr": "cp_process_expected{component=\"zalo\"}", "legendFormat": "polling expected", "refId": "A"}
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Unknown",
          "mappings": [{"type": "value", "options": {"0": {"text": "Disabled", "color": "gray"}, "1": {"text": "Expected", "color": "blue"}}}]
        },
        "overrides": []
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "cp-assistant"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "Asia/Ho_Chi_Minh",
  "title": "CP Assistant — chi phí, độ trễ, cache",
  "uid": "cp-assistant",
  "version": 6
}
